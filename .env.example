# AetherWeather environment variables
# Copy this file to .env and fill in values as needed.
# Keys are read at build time via import.meta.env (VITE_ prefix).

# Weather API provider: "open-meteo" (keyless, default) or "openweather" (requires key below)
VITE_WEATHER_API_PROVIDER=open-meteo

# Weather API key (required only if using a keyed provider like OpenWeather)
VITE_WEATHER_API_KEY=

# Map / tile API key (optional — base map uses OpenStreetMap by default)
VITE_MAP_API_KEY=

# Air quality API key (optional — Open-Meteo Air Quality is keyless by default)
VITE_AIR_QUALITY_API_KEY=
